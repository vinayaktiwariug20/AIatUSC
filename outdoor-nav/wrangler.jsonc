{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiatusc-outdoor-nav",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "assets": {
    "directory": "./outdoor/static",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "PUBLIC_REPORTS_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiatusc-closures",
      "database_id": "73fc86ba-e57f-4c60-95f1-566164dd6f61",
      "migrations_dir": "migrations"
    }
  ]
}
